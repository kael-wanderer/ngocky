{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "NgocKy",
    "version": "1.1.0",
    "identifier": "vn.kael.ngocky",
    "build": {
        "beforeBuildCommand": "npm run build:web",
        "frontendDist": "../../web/dist"
    },
    "app": {
        "windows": [
            {
                "title": "NgocKy",
                "width": 1440,
                "height": 900,
                "minWidth": 1024,
                "minHeight": 700,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["dmg", "msi", "app"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}

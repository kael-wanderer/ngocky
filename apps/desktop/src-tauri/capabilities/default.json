{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Default NgocKy desktop permissions",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "opener:default",
        "process:allow-restart",
        "notification:default",
        {
            "identifier": "shell:allow-execute",
            "allow": [{ "name": "binaries/ngocky-api", "sidecar": true, "args": true }]
        }
    ]
}

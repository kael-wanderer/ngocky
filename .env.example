# ─── App ────────────────────────────────────────
APP_PORT=3001
API_PORT=3001
WEB_PORT=5173
APP_VERSION=1.1.0
NODE_ENV=development

# ─── Database ───────────────────────────────────
DB_PASSWORD=ngocky_secret
DATABASE_URL=postgresql://ngocky:ngocky_secret@localhost:5433/ngocky?schema=public

# ─── JWT ────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Optional Owner Seed ────────────────────────
# Leave OWNER_EMAIL and OWNER_PASSWORD unset to use the in-app setup wizard.
OWNER_NAME=Owner
# OWNER_EMAIL=owner@example.local
# OWNER_PASSWORD=ChangeMe123!

# ─── Frontend ───────────────────────────────────
VITE_API_URL=http://localhost:3001/api

# ─── CORS ───────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Chat Assistant ──────────────────────────────
# Shared secret between n8n and the assistant API routes (min 16 chars)
ASSISTANT_API_KEY=change-me-to-a-random-secret-at-least-32-chars
# OpenAI API key for LLM intent parsing. Optional — the OWNER can also set it
# in Settings → Application (stored encrypted in the DB; DB key wins over env).
# OPENAI_API_KEY=sk-...
# ALLOW_PRIVATE_AGENT_ENDPOINTS=false
# Encryption key for secrets stored in the DB (OpenAI key). Optional —
# falls back to a key derived from JWT_SECRET. If you rotate JWT_SECRET
# without setting this, stored secrets must be re-entered in the UI.
# APP_ENCRYPTION_KEY=change-me-random-32-chars
